# syntax=docker/dockerfile:1

FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/src \
    RTT_API_HOST=0.0.0.0 \
    RTT_API_PORT=8765

WORKDIR /app

# faster-whisper / torch wheels may need basic build tools on slim images
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        curl \
        libsndfile1 \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt requirements-guards.txt ./
RUN pip install --no-cache-dir -r requirements.txt -r requirements-guards.txt \
    && python -m camel_tools.cli.camel_data -i morphology-db-msa-r13

COPY src/ src/
COPY scripts/ scripts/
COPY docker/entrypoint-api.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

RUN mkdir -p /app/models /app/outputs

EXPOSE 8765

HEALTHCHECK --interval=30s --timeout=10s --start-period=120s --retries=3 \
    CMD curl -fsS "http://127.0.0.1:${RTT_API_PORT}/health" || exit 1

ENTRYPOINT ["/entrypoint.sh"]
CMD ["sh", "-c", "python -m uvicorn rtt.api.production_server:app --host \"${RTT_API_HOST:-0.0.0.0}\" --port \"${RTT_API_PORT:-8765}\""]
