# Copy to .env and adjust for your host.
#   cp .env.example .env
#
# Requires Python 3.12.x locally (see .python-version). Docker already uses 3.12.

# --- Public site (reverse proxy) ---
# Domain Caddy terminates TLS for. Use localhost for local Docker HTTPS.
RTT_PUBLIC_HOST=localhost

# Full public URLs (optional; UI auto-uses same-origin wss://HOST/ws when unset)
# RTT_PUBLIC_URL=https://translate.example.com
# RTT_PUBLIC_WS_URL=wss://translate.example.com/ws

# --- API ---
RTT_API_HOST=0.0.0.0
RTT_API_PORT=8765

# Comma-separated origins when UI and API run on different hosts (dev split deploy).
# RTT_CORS_ORIGINS=https://translate.example.com,http://localhost:3000

# Skip model warmup on container start (faster boot; /ready is 503 until loaded)
# RTT_SKIP_MODEL_WARMUP=0

# Structured JSON logs (1) or plain text (0)
# RTT_JSON_LOGS=1
# RTT_LOG_LEVEL=INFO

# --- Pipeline tuning (see README) ---
RTT_ASR_MODEL=medium
RTT_MT_BACKEND=nllb
RTT_NLLB_SOURCE_LANG=apc_Arab
RTT_LIVE_ASR_MODEL=tiny
RTT_LIVE_MT_BACKEND=marian

# --- Model cache (persisted in Docker volume rtt-models) ---
# RTT_ASR_DOWNLOAD_ROOT=/app/models/whisper
# RTT_MT_CACHE_DIR=/app/models/mt

# Hugging Face offline after first download:
# HF_HUB_OFFLINE=1

# --- Optional research channels (off by default) ---
# RTT_SECOND_OPINION_ENABLED=1
# RTT_SECOND_OPINION_MODEL=facebook/hf-seamless-m4t-medium
# RTT_SECOND_OPINION_CACHE_DIR=/app/models/second_opinion
